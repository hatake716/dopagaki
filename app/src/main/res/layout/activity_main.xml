<?xml version="1.0" encoding="utf-8"?>
<!--
  ConstraintLayout の res-auto 属性がこの開発環境の aapt2 でリンクできないため、
  LinearLayout の weight（= 上ペイン比率）で等価な構成にしている（SPEC.md §5 注記）。
  DividerView は境界に重ねるオーバーレイで、位置は MainActivity が translationY で同期する。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/brandBar"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/black">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@mipmap/ic_launcher"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/app_name"
                android:textColor="@color/divider_pill"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:includeFontPadding="false" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/paneTopContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/black">

            <io.github.hatake716.dopagaki.PaneWebView
                android:id="@+id/webYoutube"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/paneBottomContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@color/black">

            <io.github.hatake716.dopagaki.PaneWebView
                android:id="@+id/webX"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <io.github.hatake716.dopagaki.DividerView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</FrameLayout>
