<?xml version="1.0" encoding="utf-8"?>
<!--
  ConstraintLayout の res-auto 属性がこの開発環境の aapt2 でリンクできないため、
  LinearLayout の weight（= 上ペイン比率）で等価な構成にしている（SPEC.md §5 注記）。
  DividerView は境界に重ねるオーバーレイで、位置は MainActivity が translationY で同期する。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/paneTopContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/black">

            <io.github.hatake716.dopagaki.PaneWebView
                android:id="@+id/webYoutube"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/paneBottomContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@color/black">

            <io.github.hatake716.dopagaki.PaneWebView
                android:id="@+id/webX"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <io.github.hatake716.dopagaki.DividerView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</FrameLayout>
